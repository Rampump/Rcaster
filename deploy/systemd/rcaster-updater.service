[Unit]
Description=RCaster supervised updater
Conflicts=rcaster.service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rcaster
Group=rcaster
ExecStart=/opt/rcaster/rcaster-updater supervise --config /etc/rcaster/updater.json
Restart=on-failure
RestartSec=2s
TimeoutStopSec=330s
KillMode=mixed
LimitNOFILE=131072
UMask=0077

StateDirectory=rcaster
LogsDirectory=rcaster
RuntimeDirectory=rcaster
ReadWritePaths=-/var/lib/rcaster /var/log/rcaster

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
